_bin="$(
  dirname \
    "$(command \
        -v \
	  "env")")"
_lib="${_bin}/../lib"
source \
  "${_lib}/libcrash-bash/crash-bash"

# shellcheck disable=SC2034
_global_variables() {
  target_host=""
  target_device=""
  target_user=""
  target_address=""
  target_port=""
  tunnel_local=""
  tunnel_remote=""
  proxy_address=""
  proxy_port=""
  ssh_command=""
  monitor_port=""
  ssh_options=()
  connect_date=""
  color=""
  quiet=""
}

_requirements() {
  local \
    _pkg="ssh"
  _check_cmd \
    "${_pkg}" \
    "open${_pkg}"
  _check_cmd \
    "mk${_pkg}config" \
    "${_pkg}-utils"
  _check_cmd \
    "hotspot-resolver"
}

_get_conf_path() {
  local \
    _dir \
    _conf
  _dir="${HOME}/.config/${app_name}"
  _conf="${_dir}/${target_host}.cfg"
  echo \
    "${_conf}"
}

_autossh_run() {
  AUTOSSH_PORT="${_monitor_port}" \
  "${_command}" \
    "${_ssh_opts[@]}" \
    "${_args[@]}"
}

_sshfs_run() {
  "${_command}" \
    -F \
      "${_sshcfg}" \
    -o
      "StrictHostKeyChecking=no"
    "${_args[@]}"
}

_rsync_run() {
  "${_command}" \
    -e \
      "ssh ${_ssh_opts[*]}" \
    -az \
    "${_args[@]}"
}

_ssh_run() {
  "${_command}" \
    "${_ssh_opts[@]}" \
      "${_args[@]}"
}

_sshfs_run() {
  local \
    _sshfs_opts=() \
    _cmd=() \
    _uid \
    _gid
  _uid="$(
    id \
      -u)"
  _gid="$(
    id \
      -g)"
  _sshfs_opts+=(
    -v
    -F
      "${_sshcfg}"
    -o
      "uid=${_uid}"
    -o
      "gid=${_gid}"
    -o
      "auto_unmount"
    -o
      "allow_other"
  )
  _cmd=(
    "${_command}"
      "${_sshfs_opts[@]}"
      "${_args[@]}"
  )
  sudo \
    "${_cmd[@]}"
}

# Local ssh resolver
# $1: hostname of the device to connect
# $2: network device name
_dynssh() {
  local \
    _host="${1}" \
    _address="${2}" \
    _device="${3}" \
    _user="${4}" \
    _port="${5}" \
    _tunnel_local="${6}" \
    _tunnel_remote="${7}" \
    _proxy_address="${8}" \
    _proxy_port="${9}" \
    _command="${10}" \
    _monitor_port="${11}" \
    _ssh_opts=() \
    _args=() \
    _msg=() \
    _cache \
    _sshcfg \
    _mksshconfig_opts=() \
    _hotspot_resolver_opts=() \
    _conf \
    _cfg \
    _address \
    _tmp
  shift \
    11
  _args=(
    "$@"
  )
  _conf="$(
    _get_conf_path \
      "${_host}")"
  _cache="$(
    _get_cache \
      "${app_name}" \
      "${_host}")"
  _tmp="$(
    mktemp \
      -d)"
  _sshcfg="${_tmp}/ssh.config"
  if [[ "${quiet}" == "n" ]]; then
    _ssh_opts+=(
      -v
    )
  fi
  _ssh_opts+=(
    -t
    -F
      "${_sshcfg}"
    -o
      "StrictHostKeyChecking=no"
  )
  mkdir \
    -p \
    "${_cache}"
  if [[ "${_port}" == "" ]]; then
    _port="$(
      _read_settings \
        "${_conf}" \
        "${_host}" \
        "port")"
  fi
  if \
    [[ "${_tunnel_local}" != "" ]] || \
    [[ "${_tunnel_remote}" != "" ]]; then
    if \
      [[ "${_tunnel_remote}" == "" ]]; then
      _tunnel_remote="${_tunnel_local}"
    fi
    if [[ "${_tunnel_local}" == "" ]]; then
      _tunnel_local="${_tunnel_remote}"
    fi
    _mksshconfig_opts+=(
      -l
        "${_tunnel_local}"
      -r
        "${_tunnel_remote}"
    )
  fi
  if [[ "${_proxy_address}" != "" ]]; then
    _mksshconfig_opts+=(
      -p
        "${_proxy_address}"
    )
  fi
  if [[ "${_proxy_port}" != "" ]]; then
    _mksshconfig_opts+=(
      -P
        "${_proxy_port}"
    )
  fi
  if [[ "${_address}" == "" ]]; then 
    if [[ -v "HOTSPOT_RESOLVER_OPTS" ]]; then
      _hotspot_resolver_opts+=(
        ${HOTSPOT_RESOLVER_OPTS}
      )
    fi 
    _hotspot_resolver_opts+=(
      -d 
        "${_device}"
    )
    _address="$(
      hotspot-resolver \
        "${_hotspot_resolver_opts[@]}" \
        get \
          "${_host}")"
  fi
  _msg=(
    "connecting to ${_user}@${_address}:${_port}"
  )
  _msg_info \
    "${_msg[*]}"
  _msg_info \
    "mksshconfig opts: ${_mksshconfig_opts[@]}"
  rm \
    -f \
    "${_sshcfg}"
  mksshconfig \
    "${_mksshconfig_opts[@]}" \
    "${_sshcfg}" \
    "${_host}" \
    "${_address}" \
    "${_user}" \
    "${_port}"
  # _connection_test
  _msg_info \
    "ssh config: $(
      cat \
        "${_sshcfg}")"
  _command_name="$(
    basename \
      "${_command}")"
  "_${_command_name}_run"
  rm \
    -rf \
    "${_tmp}"
  return \
    0
}

_connection_test() {
  if "${_command}" \
       -q \
       -F "${_sshcfg}" \
       -o StrictHostKeyChecking=no \
       -o ConnectTimeOut=5 \
       "${_host}" \
       'exit 0'; then
    return
  fi
  _msg_error \
    "can't connect to host '${_host}" \
    1
}

_make_conf() {
  local \
    _host="${1}" \
    _conf="${2}" \
    _port="${3}"
  if [[ "${_conf}" == "" ]]; then
    _conf="$(
      _get_conf_path \
        "${_host}")"
  fi
  mkdir \
    -p \
    "$(dirname \
         "${_conf}")"
  _write_setting \
    "${_conf}" \
    "port" \
    "${_port}"
  # _write_setting \
  #   "${_conf}" \
  #   "method" \
  #   "hotspot-resolver"
}

_check_conf() {
  local \
    _conf="${1}" \
    _host="${2}" \
    _address \
    _dir \
    _port \
    _msg=() \
    _perm
  if [[ "${_conf}" == "" ]]; then
    _conf="$(
      _get_conf_path \
        "${_host}")"
  fi
  _msg=(
    "Configuration file:"
    "${_conf}"
  )
  _msg_info \
    "${_msg[*]}"
  if [ ! -e  "${_conf}" ]; then
    _make_conf
  fi
  _perm="$(
    stat \
      -c '%a' \
      "${_conf}")"
  if [[ "${_perm}" != "700" ]]; then
    chmod \
      700 \
      "${_conf}"
  fi
}

_input_credentials() {
  local \
    _msg=()
  if [[ "${_host}" == "" ]]; then
    _host="$(
      hostnamectl \
        hostname)"
  fi
  if [[ "${_host}" == "" ]]; then
    # _input \
    #   "_host" \
    #   "enter name for this host"
    printf \
      "  %s\n" \
      "enter name for this host:" && \
    while \
      [[ ! -v "_host" ]]; do
      read \
        -r \
        _host
    done
  fi
  printf \
    -v \
      "_port" \
    "%s\n" \
    "${target_port}"
  _msg=(
    "Setting local port as"
    "target port '${_port}'."
  )
  _msg_info \
    "${_msg[*]}"
  if \
    [[ \
      "${_port}" == "" ]]; then
    _msg=(
      "Enter port for this host:"
    )
    printf \
      "  %s\n" \
      "${_msg[*]}"
    while \
      [[ "${_port}" == "" ]]; do
      read \
        -r \
        "_port"
    done
  fi
  _msg=(
    "Set port '${_port}'."
  )
  _msg_info \
    "${_msg[*]}"
}

_get_ssh() {
  local \
    _sshs=() \
    _cmd \
    _ssh
  _sshs=(
    'autossh'
    'ssh'
  )
  for _ssh \
    in "${_sshs[@]}"; do
    _cmd="$( \
      command \
        -v \
        "${_ssh}")"
    if [[ "${_cmd}" != "" ]]; then
      echo \
        "${_cmd}"
      break
    fi
  done
}

_set_overrides() {
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  _set_override \
    "connect" \
    "date" \
    "$(_get_date_human)"
  _set_override \
    "ssh" \
    "command" \
    "$(_get_ssh)"
  _set_override \
    "monitor" \
    "port" \
    "$(unused-local-port)"
  _set_override \
    "target" \
    "host" \
    ""
  _set_override \
    "target" \
    "device" \
    "wlan0"
  _set_override \
    "target" \
    "user" \
    "dev"
  _set_override \
    "target" \
    "port" \
    "2222"
  _set_override \
    "tunnel" \
    "local" \
    ""
  _set_override \
    "tunnel" \
    "remote" \
    ""
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _exit_code="${1}" \
    _usage_text
  IFS='' \
    read \
      -r \
      -d '' \
      _usage_text << \
        ENDUSAGETEXT || true

SSH client with host address auto-detection.

usage:

  ${app_name}
    [options]
    <host>
    [ssh-options]

  options:

     -t <target-host>         Specify target host
     -a <address>             Specify target address
                              Default: '${target_address}'
     -d <device>              Specify network device
                              Default: '${target_device}'
     -u <user>                user to connect to.
                              Default: '${target_user}'
     -p <port>                Connect through a specific port.
                              Default: '${target_port}'
     -l <local-port>          Tunnel on given local port
                              Default: '${tunnel_local}'
     -r <remote-port>         Tunnel on given remote port
                              Default: '${tunnel_remote}'
     -T <proxy-address>       Specify a proxy address
     -P <proxy-port>          Specify a proxy port
     -C <ssh-path>            Connect using a specific ssh supporting binary,
                              (ssh, autossh, rsync, sshfs).
                              Default: '${ssh_command}'
     -m <monitor-port>        Specify monitor port when using autossh
                              Default: '${monitor_port}'

     -h                       This message.
     -c                       Enable color output
     -v                       Enable verbose output

  environment variable:

     HOTSPOT_RESOLVER_OPTS   This variable is read to pass custom options
                             to 'hotspot-resolver' (for example the global
                             host option '-G').

ENDUSAGETEXT
  _printf \
    '%s\n' \
    "${_usage_text}"
  exit \
    "${_exit_code}"
}

_display_flags() {
  local \
    _flags=(
      "${1}"
    ) \
    _flag
  for _flag \
    in "${_flags[@]}"; do
  _msg_info \
    "                             ${_flag}"
  done
}

# Shows configuration options.
_show_config() {
  _msg_info "${app_name} configuration"
  _msg_info "          Connection date:   ${connect_date}"
  _msg_info "              SSH command:   ${ssh_command}"
  _msg_info "                     Host:   ${target_host}"
  _msg_info "                   Device:   ${target_device}"
  _msg_info "                     User:   ${target_user}"
  _msg_info "                  Address:   ${target_address}"
  _msg_info "                     Port:   ${target_port}"
  _msg_info "        Tunnel local port:   ${tunnel_local}"
  _msg_info "       Tunnel remote port:   ${tunnel_remote}"
  _msg_info "            Proxy address:   ${proxy_address}"
  _msg_info "               Proxy port:   ${proxy_port}"
  _msg_info "             Monitor Port:   ${monitor_port}"
  _msg_info "       Configuration file:   $(_get_conf_path \
                                              "${target_host}")"
  if [[ "${ssh_options}" != "" ]]; then
    _msg_info \
      "              SSH options:   ${ssh_options[*]}"
  fi
}

_globals
_global_variables
_requirements
# shellcheck disable=SC2034
while \
  getopts \
    't:a:d:u:p:l:r:T:P:C:m:cvh?' \
    arg; do
  case \
    "${arg}" in
    t)
      override_target_host="${OPTARG}" ;;
    a)
      override_target_address="${OPTARG}" ;;
    d)
      override_target_device="${OPTARG}" ;;
    u)
      override_target_user="${OPTARG}" ;;
    p)
      override_target_port="${OPTARG}" ;;
    l)
      override_tunnel_local="${OPTARG}" ;;
    r)
      override_tunnel_remote="${OPTARG}" ;;
    T)
      override_proxy_address="${OPTARG}" ;;
    P)
      override_proxy_port="${OPTARG}" ;;
    C)
      override_ssh_command="${OPTARG}" ;;
    m)
      override_monitor_port="${OPTARG}" ;;
    c)
      override_color="y" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _set_overrides
      _usage \
        0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
      _usage \
        1 ;;
  esac
done
shift \
  $((
    OPTIND - 1 \
  ))
ssh_options=(
  "$@"
)
_set_overrides
_config_user_init \
  "${app_name}"
if [[ "${target_host}" == "" ]]; then
  _msg=(
   "The '-t' option is required."
  )
  _msg_error \
    "${_msg[*]}" \
    0
  _usage \
   1
fi
app_opts=(
  "${target_host}"
  "${target_address}"
  "${target_device}"
  "${target_user}"
  "${target_port}"
  "${tunnel_local}"
  "${tunnel_remote}"
  "${proxy_address}"
  "${proxy_port}"
  "${ssh_command}"
  "${monitor_port}"
  "${ssh_options[@]}"
)
_show_config
_dynssh \
  "${app_opts[@]}"

